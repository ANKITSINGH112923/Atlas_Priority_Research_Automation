          },
          "conditions": [
            {
              "id": "335129c6-07dd-56d4-89f2-b24dcc13405a",
              "leftValue": "={{ $('Webhook').item.json.body.priority }}",
              "rightValue": "urgent",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0709e6c4-fca3-506d-b799-8f6708700147",
